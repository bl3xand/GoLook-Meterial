<?xml version='1.0' encoding='utf-8'?>
<resources>
  <style name="Theme.MaterialUi" parent="@style/Theme.Material3Expressive.DynamicColors.DayNight.NoActionBar">
    <item name="linearProgressIndicatorStyle">@style/Widget.Material3Expressive.LinearProgressIndicator.Wavy</item>
    <item name="circularProgressIndicatorStyle">@style/Widget.MaterialUi.Progress.Circular</item>
    <item name="materialButtonStyle">@style/Widget.MaterialUi.Button</item>
    <item name="materialButtonTonalStyle">@style/Widget.Material3.Button.TonalButton</item>
    <item name="android:dialogTheme">@style/ThemeOverlay.MaterialUi.Dialog</item>
    <item name="android:alertDialogTheme">@style/Theme.MaterialUi.PlatformAlert</item>
    <item name="dialogTheme">@style/ThemeOverlay.MaterialUi.Dialog</item>
    <item name="alertDialogTheme">@style/ThemeOverlay.MaterialUi.Dialog.Alert</item>
    <item name="android:windowLightStatusBar">true</item>
    <item name="android:windowLightNavigationBar">true</item>
    <item name="android:statusBarColor">@color/material_ui_surface</item>
    <item name="android:navigationBarColor">@color/material_ui_surface</item>
    <item name="android:windowBackground">@color/material_ui_surface</item>
    <item name="android:textColorHint">@color/material_ui_on_surface_variant</item>
    <item name="android:editTextColor">@color/material_ui_on_surface</item>
    <item name="android:windowSoftInputMode">adjustResize</item>
    <item name="bottomSheetDialogTheme">@style/ThemeOverlay.MaterialUi.BottomSheet</item>
    <item name="bottomSheetStyle">@style/Widget.MaterialUi.BottomSheet</item>
    <item name="android:seekBarStyle">@style/Widget.MaterialUi.SeekBar</item>
    <item name="selectableItemBackground">@drawable/material_ui_settings_row_bg</item>
    <item name="android:selectableItemBackground">@drawable/material_ui_settings_row_bg</item>
    <item name="android:listViewStyle">@style/Widget.MaterialUi.ListView</item>
  </style>
  <style name="Widget.MaterialUi.ListView" parent="@android:style/Widget.Material.ListView">
    <item name="android:listSelector">@drawable/material_ui_settings_row_bg</item>
  </style>
  <style name="Widget.MaterialUi.PreferenceList" parent="@style/Widget.MaterialUi.ListView">
    <item name="android:listSelector">@android:color/transparent</item>
  </style>
  <style name="ThemeOverlay.MaterialUi.Dialog" parent="@style/ThemeOverlay.Material3.MaterialAlertDialog">
    <item name="android:listViewStyle">@style/Widget.MaterialUi.ListView</item>
    <item name="android:background">@null</item>
    <item name="android:windowFrame">@null</item>
    <item name="android:windowContentOverlay">@null</item>
    <item name="android:windowBackground">@drawable/material_ui_dialog_bg</item>
    <item name="android:windowMinWidthMajor">0dp</item>
    <item name="android:windowMinWidthMinor">0dp</item>
    <item name="materialButtonStyle">@style/Widget.MaterialUi.Button.Text</item>
    <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.GoLook.Dialog</item>
    <item name="dialogCornerRadius">28.0dip</item>
    <item name="android:windowSoftInputMode">adjustResize</item>
  </style>
  <style name="ThemeOverlay.MaterialUi.Dialog.Alert" parent="@style/ThemeOverlay.MaterialUi.Dialog">
    <item name="buttonBarButtonStyle">@style/Widget.MaterialUi.Button.Tonal</item>
    <item name="buttonBarPositiveButtonStyle">@style/Widget.MaterialUi.Button</item>
    <item name="buttonBarNegativeButtonStyle">@style/Widget.MaterialUi.Button.Tonal</item>
  </style>
  <style name="ShapeAppearance.GoLook.Dialog" parent="@style/ShapeAppearance.Material3.Corner.ExtraLarge">
    <item name="cornerSize">28.0dip</item>
  </style>
  <style name="Widget.MaterialUi.Button" parent="@style/Widget.Material3Expressive.Button">
    <item name="android:minHeight">48dp</item>
    <item name="android:textAllCaps">false</item>
  </style>
  <style name="Widget.MaterialUi.Button.Tonal" parent="@style/Widget.Material3Expressive.Button.TonalButton">
    <item name="android:minHeight">48dp</item>
    <item name="android:textAllCaps">false</item>
  </style>
  <style name="Widget.MaterialUi.Button.Outlined" parent="@style/Widget.Material3Expressive.Button.OutlinedButton">
    <item name="android:minHeight">48dp</item>
    <item name="android:textAllCaps">false</item>
  </style>
  <style name="Widget.MaterialUi.Button.Text" parent="@style/Widget.Material3Expressive.Button.TextButton">
    <item name="android:minHeight">48dp</item>
    <item name="android:textAllCaps">false</item>
  </style>
  <style name="Widget.MaterialUi.Button.Action" parent="@style/Widget.MaterialUi.Button.Tonal">
    <item name="android:minHeight">@dimen/material_ui_action_button_height</item>
    <item name="android:gravity">start|center_vertical</item>
    <item name="iconGravity">start</item>
    <item name="iconPadding">@dimen/material_ui_action_button_icon_padding</item>
  </style>
  <style name="Widget.MaterialUi.Button.Tall" parent="@style/Widget.MaterialUi.Button.Tonal">
    <item name="android:minHeight">@dimen/material_ui_action_button_height</item>
  </style>
  <style name="Widget.MaterialUi.Button.Tall.Outlined" parent="@style/Widget.MaterialUi.Button.Outlined">
    <item name="android:minHeight">@dimen/material_ui_action_button_height</item>
  </style>
  <style name="Widget.MaterialUi.Button.Tall.Filled" parent="@style/Widget.MaterialUi.Button">
    <item name="android:minHeight">@dimen/material_ui_action_button_height</item>
  </style>
  <style name="Theme.MaterialUi.Prefs" parent="@style/Theme.MaterialUi">
    <item name="android:listViewStyle">@style/Widget.MaterialUi.PreferenceList</item>
    <item name="android:listDivider">@null</item>
    <item name="android:divider">@null</item>
    <item name="android:dividerHeight">0dip</item>
  </style>
  <style name="Theme.MaterialUi.Fullscreen">
    <item name="android:windowFullscreen">true</item>
    <item name="android:windowBackground">@android:color/black</item>
  </style>
  <style name="TextAppearance.GoLook.Title" parent="@style/TextAppearance.Material3.HeadlineSmall" />
  <style name="TextAppearance.GoLook.Body" parent="@style/TextAppearance.Material3.BodyMedium" />
  <style name="TextAppearance.GoLook.Label" parent="@style/TextAppearance.Material3.LabelLarge" />
  <style name="Theme.MaterialUi.Preference" parent="@style/Theme.MaterialUi">
    <item name="preferenceStyle">@style/Widget.MaterialUi.Preference</item>
    <item name="android:dialogTheme">@style/ThemeOverlay.MaterialUi.Dialog</item>
    <item name="android:alertDialogTheme">@style/Theme.MaterialUi.PlatformAlert</item>
    <item name="dialogTheme">@style/ThemeOverlay.MaterialUi.Dialog</item>
    <item name="alertDialogTheme">@style/ThemeOverlay.MaterialUi.Dialog.Alert</item>
  </style>
  <style name="Widget.MaterialUi.Preference" parent="@style/Preference.Material">
    <item name="android:titleTextAppearance">@style/TextAppearance.GoLook.PreferenceTitle</item>
    <item name="android:paddingStart">@dimen/material_ui_screen_margin</item>
  </style>
  <style name="TextAppearance.GoLook.PreferenceTitle" parent="@style/TextAppearance.Material3.TitleMedium">
    <item name="android:textSize">16sp</item>
  </style>
  <style name="Widget.MaterialUi.TextInput" parent="@style/Widget.Material3.TextInputLayout.OutlinedBox">
    <item name="boxCornerRadiusTopStart">12dp</item>
    <item name="boxCornerRadiusTopEnd">12dp</item>
    <item name="boxCornerRadiusBottomStart">12dp</item>
    <item name="boxCornerRadiusBottomEnd">12dp</item>
    <item name="hintTextAppearance">@style/TextAppearance.Material3.BodySmall</item>
    <item name="counterTextAppearance">@style/TextAppearance.Material3.BodySmall</item>
    <item name="counterOverflowTextAppearance">@style/TextAppearance.Material3.BodySmall</item>
    <item name="errorTextAppearance">@style/TextAppearance.Material3.BodySmall</item>
    <item name="helperTextTextAppearance">@style/TextAppearance.Material3.BodySmall</item>
    <item name="placeholderTextAppearance">@style/TextAppearance.Material3.BodySmall</item>
    <item name="prefixTextAppearance">@style/TextAppearance.Material3.BodySmall</item>
    <item name="suffixTextAppearance">@style/TextAppearance.Material3.BodySmall</item>
  </style>
  <style name="ThemeOverlay.MaterialUi.BottomSheet" parent="@style/ThemeOverlay.Material3.BottomSheetDialog">
    <item name="bottomSheetStyle">@style/Widget.MaterialUi.BottomSheet</item>
  </style>
  <style name="Widget.MaterialUi.BottomSheet" parent="@style/Widget.Material3.BottomSheet.Modal">
    <item name="backgroundTint">@color/material_ui_surface_container_low</item>
    <item name="android:backgroundTint">@color/material_ui_surface_container_low</item>
  </style>
  <style name="Widget.MaterialUi.SeekBar" parent="@style/Widget.AppCompat.SeekBar">
    <item name="android:thumb">@drawable/material_ui_slider_thumb</item>
    <item name="android:progressDrawable">@drawable/material_ui_slider_track</item>
    <item name="android:splitTrack">true</item>
    <item name="android:minHeight">16dp</item>
    <item name="android:maxHeight">16dp</item>
    <item name="android:thumbOffset">2dp</item>
  </style>
  <style name="Widget.MaterialUi.Progress.Linear" parent="@style/Widget.Material3Expressive.LinearProgressIndicator.Wavy">
    <item name="trackThickness">4dp</item>
    <item name="waveAmplitude">3dp</item>
    <item name="trackCornerRadius">2dp</item>
  </style>
  <style name="Widget.MaterialUi.Progress.Circular" parent="@style/Widget.Material3.CircularProgressIndicator">
    <item name="waveAmplitude">0dp</item>
    <item name="indicatorSize">32dp</item>
    <item name="indicatorInset">0dp</item>
    <item name="trackThickness">3dp</item>
    <item name="indicatorColor">@color/material_ui_primary</item>
    <item name="trackColor">@color/material_ui_surface_container_highest</item>
  </style>
  <!-- Platform SDK dialogs require a platform AlertDialog layout contract. -->
  <style name="Theme.MaterialUi.PlatformAlert" parent="@android:style/Theme.Material.Dialog.Alert">
    <item name="android:windowBackground">@drawable/material_ui_dialog_bg</item>
    <item name="android:colorBackground">@color/material_ui_surface</item>
    <item name="android:colorAccent">@color/material_ui_primary</item>
    <item name="android:textColorPrimary">@color/material_ui_on_surface</item>
    <item name="android:textColorSecondary">@color/material_ui_on_surface_variant</item>
    <item name="android:fontFamily">sans-serif</item>
    <item name="android:windowMinWidthMajor">88%</item>
    <item name="android:windowMinWidthMinor">88%</item>
    <item name="android:buttonBarButtonStyle">@style/Widget.MaterialUi.PlatformDialogButton</item>
  </style>
  <style name="Widget.MaterialUi.PlatformDialogButton" parent="@android:style/Widget.Material.Button.Borderless">
    <item name="android:background">@drawable/material_ui_capture_bg</item>
    <item name="android:textColor">@color/material_ui_on_primary_container</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:minHeight">48dp</item>
    <item name="android:paddingStart">16dp</item>
    <item name="android:paddingEnd">16dp</item>
  </style>
</resources>
