<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <LinearLayout android:id="@+id/material_ui_source_trigger" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/selector_actionbar_bg" android:clickable="true" android:focusable="true">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:importantForAccessibility="noHideDescendants">
            <com.google.android.material.textview.MaterialTextView android:id="@+id/material_ui_source_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Material3.BodyMedium" android:textColor="@color/material_ui_text_secondary" android:textSize="14sp" android:lineHeight="20sp" app:lineHeight="20sp" android:includeFontPadding="false" />
            <com.google.android.material.textview.MaterialTextView android:id="@+id/material_ui_source_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textAppearance="@style/TextAppearance.Material3.TitleMedium" android:textColor="@color/material_ui_text_primary" android:textSize="16sp" android:lineHeight="24sp" app:lineHeight="24sp" android:includeFontPadding="false" />
        </LinearLayout>
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="16dp" android:src="@mipmap/downarrow" android:tint="@color/material_ui_text_secondary" android:contentDescription="@null" android:importantForAccessibility="no" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/material_ui_source_copy" style="@style/Widget.MaterialUi.Button.Tonal" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" android:visibility="gone" android:textAllCaps="false" android:textSize="14sp" android:lineHeight="20sp" app:lineHeight="20sp" android:includeFontPadding="false" />
</LinearLayout>
