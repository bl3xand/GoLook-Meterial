<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/material_ui_surface">
  <local.materialui.PhotoCanvas android:layout_width="match_parent" android:layout_height="match_parent">
    <com.draggable.library.core.photoview.PhotoView android:id="@id/photo_view" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="24dp" />
  </local.materialui.PhotoCanvas>
  <FrameLayout android:id="@+id/material_ui_photo_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top">
    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp">
    <RelativeLayout android:id="@id/backLayout" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="12dp" android:layout_centerVertical="true" android:contentDescription="@string/abc_action_bar_up_description" android:background="@drawable/material_ui_icon_ripple" android:clickable="true" android:focusable="true">
      <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_centerInParent="true" android:src="@drawable/material_ui_ic_back" />
    </RelativeLayout>
    <com.google.android.material.textview.MaterialTextView android:id="@id/title_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_toEndOf="@id/backLayout" android:layout_centerVertical="true" android:layout_marginStart="16dp" android:layout_marginEnd="24dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:maxLines="1" android:ellipsize="middle" android:gravity="center_vertical" android:textSize="16sp" android:lineHeight="24sp" android:includeFontPadding="false" android:textColor="@color/material_ui_on_surface" />
    </RelativeLayout>
  </FrameLayout>
  <LinearLayout android:orientation="vertical" android:gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center">
    <com.google.android.material.progressindicator.CircularProgressIndicator android:id="@id/ibPBarProgress" android:visibility="gone" android:layout_width="32dp" android:layout_height="32dp" android:indeterminate="true" app:indicatorSize="32dp" app:indicatorInset="0dp" app:trackThickness="3dp" app:indicatorColor="@color/material_ui_primary" app:trackColor="@color/material_ui_surface_container_high" />
    <com.google.android.material.textview.MaterialTextView android:id="@id/ibprogress" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textSize="14sp" android:lineHeight="20sp" android:gravity="center" android:textColor="@color/material_ui_on_surface_variant" />
  </LinearLayout>
  <FrameLayout android:id="@+id/material_ui_photo_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:padding="24dp">
   <local.materialui.PhotoActions android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:divider="@drawable/material_ui_button_gap" android:showDividers="middle">
    <com.google.android.material.button.MaterialButton android:id="@+id/material_ui_photo_save" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/action_save" android:minWidth="0dp" app:icon="@drawable/pop_menu_icon_save" app:iconGravity="textStart" app:iconSize="20dp" app:iconPadding="8dp" android:insetTop="0dp" android:insetBottom="0dp" style="@style/Widget.MaterialUi.Button.Tonal" />
    <com.google.android.material.button.MaterialButton android:id="@+id/material_ui_photo_share" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/share" android:minWidth="0dp" app:icon="@drawable/pop_menu_icon_share" app:iconGravity="textStart" app:iconSize="20dp" app:iconPadding="8dp" android:insetTop="0dp" android:insetBottom="0dp" style="@style/Widget.MaterialUi.Button.Tonal" />
   </local.materialui.PhotoActions>
  </FrameLayout>
</FrameLayout>
